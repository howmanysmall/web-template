{
	"extends": "../../tsconfig.node.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/file-utilities.tsbuildinfo",
		"lib": ["ESNext"],
		"paths": {
			"$file-types/*": ["./src/file-types/*.ts"],
			"$file-content-utilities": ["./src/file-content-utilities.ts"]
		}
	},
	"include": ["**/*"],
	"exclude": ["dist", "node_modules"]
}
