{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/web.tsbuildinfo",
		"target": "ES2022",
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"paths": {
			"#/*": ["./src/*"],
			"@/*": ["./src/*"]
		},
		"types": ["vite/client"],
		"allowImportingTsExtensions": true,
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noUncheckedSideEffectImports": true
	},
	"include": ["**/*.ts", "**/*.tsx", ".cloudflare/types/index.d.ts", ".storybook/**/*.ts", ".storybook/**/*.tsx"]
}
