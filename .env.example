# Copy to .env (mise loads it). Never commit real values.
# App secrets, like Clerk's keys, go in each app's own .env (apps/web/.env.example).

# Cloudflare: account, D1 database, and an API token with D1 edit access.
# Used by drizzle-kit (d1-http) and `cf d1 migrations apply`.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
