{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// A static Astro build served from Workers assets. Add `main` and
	// `run_worker_first` when the site needs routes that run code.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
	},
	"compatibility_date": "{{today}}",
	"compatibility_flags": ["nodejs_compat"],
	"name": "{{workerName}}",
	"observability": {
		"enabled": true,
	},
}
