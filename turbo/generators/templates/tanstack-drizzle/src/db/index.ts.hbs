import { env } from "cloudflare:workers";
import { drizzle } from "drizzle-orm/d1";

// oxlint-disable-next-line import/no-namespace -- drizzle wants the whole schema module.
import * as schema from "./schema.ts";

/** The app's D1 database (the `DB` binding in `cloudflare.config.ts`). */
// oxlint-disable-next-line small-rules/prevent-abbreviations -- the CLI's demo routes import `db`.
export const db = drizzle(env.DB, { schema });
