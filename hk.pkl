amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

min_hk_version = "2.11.0"
jobs = 2
fail_fast = true

env {
  ["LINT_MAX_WORKERS"] = "1"
  ["RAYON_NUM_THREADS"] = "2"
  ["GOMAXPROCS"] = "2"
}

exclude =
  List(
    "node_modules",
    "dist",
    "dist-ssr",
    "coverage",
    "vendor",
    "references",
    ".git",
    ".mise",
    ".agents/skills",
    ".claude/plugins",
    ".nitro",
    ".tanstack",
    ".wrangler",
    ".cloudflare",
    "apps/*/vendor",
    ".output",
    ".vinxi",
    "storybook-static",
    "playwright-report",
    "test-results",
    "apps/*/.astro",
    "**/*-configuration.d.ts",
    "**/*.gen.ts",
    "**/*.tsbuildinfo",
    "apps/*/drizzle/meta/**/*.json",
    "apps/*/migrations/meta/**/*.json",
  )

local WORKFLOW_FILES =
  List(
    ".github/workflows/**/*.{yml,yaml}",
    ".github/actions/**/action.{yml,yaml}",
  )
local ECMA_FILES = List("**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}")
local DATA_FILES = List("**/*.{json,jsonc,json5,yaml,yml,css,scss,less,html,graphql,gql}")
local GENERATED_DATA = List("**/*-lock.{json,yaml}", "mise.lock", "skills-lock.json", "patches/**")

local fileChecks = new Mapping<String, Step> {
  ["type-check"] {
    glob =
      ECMA_FILES
        + List("**/tsconfig*.json", "**/package.json", "pnpm-workspace.yaml", "pnpm-lock.yaml")
    exclusive = true
    check = new CommandSpec {
      command = new Command {
        argv = List("node", "--run", "type-check")
      }
      effect = "write"
    }
  }
  ["isentinel-lint"] {
    glob = ECMA_FILES + DATA_FILES
    exclude = GENERATED_DATA
    depends = List("type-check")
    batch = false
    check = new CommandSpec {
      command = new Command {
        argv = List("node", "--run", "isentinel-lint", "--", "{{files}}")
      }
      effect = "write"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("node", "--run", "isentinel-lint", "--", "--fix", "{{files}}")
      }
      effect = "write"
    }
  }
  ["biome"] = (Builtins.biome) {
    glob = ECMA_FILES + List("**/*.{json,jsonc,css,html,graphql,gql}")
    exclude = GENERATED_DATA
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "biome",
            "check",
            "--formatter-enabled=false",
            "--no-errors-on-unmatched",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv =
          List(
            "biome",
            "check",
            "--write",
            "--formatter-enabled=false",
            "--no-errors-on-unmatched",
            "{{files}}",
          )
      }
      effect = "write"
    }
  }
  ["sherif"] = (Builtins.sherif) {
    fix = null
  }
  ["shellcheck"] = (Builtins.shellcheck) {
    batch = false
    exclude = List(".claude/hooks/fallow-gate.sh")
  }
  ["shfmt"] = (Builtins.shfmt) {
    batch = false
    check_diff = (Builtins.shfmt.check_diff) {
      command = new Command {
        argv = List("shfmt", "-d", "--apply-ignore", "-bn", "-ci", "-sr", "{{files}}")
      }
    }
    check_list_files = (Builtins.shfmt.check_list_files) {
      command = new Command {
        argv = List("shfmt", "-l", "--apply-ignore", "-bn", "-ci", "-sr", "{{files}}")
      }
    }
    fix = (Builtins.shfmt.fix) {
      command = new Command {
        argv = List("shfmt", "-w", "--apply-ignore", "-bn", "-ci", "-sr", "{{files}}")
      }
    }
  }
  ["jactionlint"] = (Builtins.jactionlint) {
    // The builtin only matches workflows; composite actions get the same
    // checks, template injection included.
    glob = Builtins.jactionlint.glob + List(".github/actions/**/action.{yml,yaml}")
  }
  ["sqlfluff"] {
    glob = List("**/*.sql")
    // Drizzle generates the apps' migrations.
    exclude = List("apps/*/drizzle/**")
    check = new CommandSpec {
      command = new Command {
        argv = List("sqlfluff", "lint", "{{files}}")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("sqlfluff", "fix", "--force", "{{files}}")
      }
      effect = "write"
    }
  }
  ["fish-syntax"] {
    glob = List("**/*.fish")
    batch = false
    check = new CommandSpec {
      command = new Command {
        argv = List("fish", "--no-config", "--no-execute", "{{files}}")
      }
      effect = "read"
    }
  }
  ["fish-indent"] {
    glob = List("**/*.fish")
    check = new CommandSpec {
      command = new Command {
        argv = List("fish", "--no-config", "--command", "fish_indent --check $argv", "{{files}}")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("fish", "--no-config", "--command", "fish_indent --write $argv", "{{files}}")
      }
      effect = "write"
    }
  }
  ["pinact"] {
    glob = WORKFLOW_FILES
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "bash",
            "-c",
            "PINACT_GITHUB_TOKEN=\"$(gh auth token)\" pinact run --verify \"$@\"",
            "_",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv =
          List(
            "bash",
            "-c",
            "PINACT_GITHUB_TOKEN=\"$(gh auth token)\" pinact run \"$@\"",
            "_",
            "{{files}}",
          )
      }
      effect = "write"
    }
  }
  ["tombi"] = Builtins.tombi
  ["tombi-format"] = Builtins.tombi_format
  ["pkl-format"] = Builtins.pkl_format
  ["rumdl"] = (Builtins.rumdl) {
    glob = List("**/*.{md,markdown,mdx}")
  }
  ["betterleaks"] {
    check = new CommandSpec {
      command = new Command {
        argv = List("betterleaks", "git", "--pre-commit", "--staged", "--redact", "--no-banner")
      }
      effect = "read"
    }
  }
  ["merge-conflicts"] = Builtins.check_merge_conflict
  ["case-conflicts"] = Builtins.check_case_conflict
  ["symlinks"] = Builtins.check_symlinks
  ["destroyed-symlinks"] {
    glob = "**/*"
    allow_symlinks = true
    check = new CommandSpec {
      command = new Command {
        argv = List("hk", "util", "destroyed-symlinks", "{{files}}")
      }
      effect = "read"
    }
  }
  ["executable-shebangs"] = Builtins.check_executables_have_shebangs
  ["shebang-executables"] {
    types = List("text")
    check = new CommandSpec {
      command = new Command {
        argv = List("hk", "util", "check-shebang-scripts-are-executable", "{{files}}")
      }
      effect = "read"
    }
  }
  ["private-keys"] = Builtins.detect_private_key
  ["large-files"] = (Builtins.check_added_large_files) {
    allow_binary = true
    // The lockfile outgrows the 1 MB limit in any real workspace.
    exclude = List("pnpm-lock.yaml")
    check = new CommandSpec {
      command = new Command {
        argv = List("hk", "util", "check-added-large-files", "--maxkb", "1024", "{{files}}")
      }
      effect = "read"
    }
  }
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
    // rumdl preserves Markdown hard breaks while checking whitespace.
    exclude = GENERATED_DATA + List("**/*.{md,markdown,mdx}")
  }
  ["final-newline"] = (Builtins.newlines) {
    // Biome formats Astro files and ends a frontmatter-only page with a blank line.
    exclude = GENERATED_DATA + List("**/*.astro")
  }
  ["line-endings"] = (Builtins.mixed_line_ending) {
    exclude = GENERATED_DATA
  }
  ["byte-order-marker"] = (Builtins.byte_order_marker) {
    exclude = GENERATED_DATA
  }
}

steps = fileChecks

hooks {
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = new CommandSpec {
          command = new Command {
            argv = List("commitlint", "--edit", "{{commit_msg_file}}")
          }
          effect = "read"
        }
      }
    }
  }
  ["fix"] {
    steps {
      ["sherif"] = (Builtins.sherif) {
        exclusive = true
      }
    }
  }
  // HACKATHON=1 skips the slow pre-push steps (dead code, unit tests, package
  // builds) through scripts/unless-hackathon.sh. Secret scanning always runs.
  ["pre-push"] {
    fix = false
    stage = false
    steps = (fileChecks) {
      ["type-check"] { glob = null }
      ["betterleaks"] {
        stdin = "{{hook_stdin}}"
        check = new CommandSpec {
          command = new Command {
            argv = List("bash", "scripts/betterleaks-pre-push.sh")
          }
          effect = "read"
        }
      }
      ["fallow"] {
        check = new CommandSpec {
          command = new Command {
            argv = List("bash", "scripts/unless-hackathon.sh", "fallow", "dead-code")
          }
          effect = "write"
        }
      }
      ["unit-tests"] {
        depends = List("type-check")
        exclusive = true
        env { ["CI"] = "1" }
        check = new CommandSpec {
          command = new Command {
            argv =
              List(
                "bash",
                "scripts/unless-hackathon.sh",
                "turbo",
                "run",
                "test",
                "--concurrency=1",
                "--",
                "--maxWorkers=2",
              )
          }
          effect = "write"
        }
      }
      ["package-builds"] {
        depends = List("unit-tests")
        exclusive = true
        env { ["CI"] = "1" }
        check = new CommandSpec {
          command = new Command {
            argv =
              List(
                "bash",
                "scripts/unless-hackathon.sh",
                "turbo",
                "run",
                "build",
                "--filter=./packages/*",
                "--filter=./tools/*",
                "--concurrency=1",
              )
          }
          effect = "write"
        }
      }
    }
  }
  ["reports"] {
    steps {
      ["browser-tests"] {
        profiles = List("browser-tests")
        env {
          ["CI"] = "1"
        }
        check = new CommandSpec {
          command = new Command {
            argv =
              List(
                "turbo",
                "run",
                "test",
                "test:browser",
                "--",
                "--maxWorkers=2",
              )
          }
          effect = "write"
        }
      }
      ["app-builds"] {
        profiles = List("app-builds")
        env {
          ["CI"] = "1"
        }
        check = new CommandSpec {
          command = new Command {
            argv = List("turbo", "run", "build", "--filter=./apps/*")
          }
          effect = "write"
        }
      }
      ["duplicates"] {
        profiles = List("duplicates")
        check = new CommandSpec {
          command = new Command {
            argv = List("fallow", "dupes")
          }
          effect = "write"
        }
      }
      ["health"] {
        profiles = List("health")
        check = new CommandSpec {
          command = new Command {
            argv = List("fallow", "health", "--hotspots", "--targets", "--css", "--report-only")
          }
          effect = "write"
        }
      }
      ["react-doctor"] {
        profiles = List("react-doctor")
        check = new CommandSpec {
          command = new Command {
            argv =
              List(
                "react-doctor",
                "apps/web",
                "--yes",
                "--no-score",
                "--no-telemetry",
                "--no-supply-chain",
                "--no-parallel",
              )
          }
          effect = "write"
        }
      }
      ["security"] {
        profiles = List("security")
        check = new CommandSpec {
          command = new Command {
            argv = List("fallow", "security")
          }
          effect = "write"
        }
      }
      ["dependency-audit"] {
        profiles = List("dependency-audit")
        check = new CommandSpec {
          command = new Command {
            argv = List("pnpm", "audit", "--prod")
          }
          effect = "read"
        }
      }
    }
  }
}
