{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"attribution": {
		"sessionUrl": false
	},
	"hooks": {
		"PostToolBatch": [
			{
				"hooks": [
					{
						"command": "bun run \"$CLAUDE_PROJECT_DIR/.claude/hooks/react-doctor.ts\"",
						"type": "command"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"hooks": [
					{
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fallow-gate.sh",
						"type": "command"
					}
				],
				"matcher": "Bash"
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"command": "hk run check --safe --format json",
						"type": "command"
					}
				]
			}
		]
	}
}
